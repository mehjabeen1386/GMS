# Application Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/aigcwms_prod
MONGODB_MAX_POOL_SIZE=10

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRATION=7d

# Security Configuration
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info