# Purpose: Environment Variables Example Template
# Path: backend/.env.example
# Application Server Configuration
NODE_ENV=development
PORT=5000
# MongoDB Database Connection String
# Local Mongo Example: mongodb://localhost:27017/garment_db
# Mongo Atlas Example: mongodb+srv://<user>:<password>@cluster.mongodb.net/garment_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/garment_db
# JSON Web Token (JWT) Security Secrets
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters
JWT_EXPIRES_IN=1d
# Cross-Origin Resource Sharing (CORS) Configuration
# Set to specific frontend URL in production, e.g., https://app.garment.com
CORS_ORIGIN=http://localhost:3000
# File Upload & Storage Limits (in bytes or MB string)
MAX_FILE_SIZE=10485760
# Logging & Monitoring Configuration
LOG_LEVEL=debug
